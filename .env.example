# Port for the web server
PORT=3000

# RescueGroups.org v5 API key (free for adoption-related apps):
# https://rescuegroups.org/services/adoptable-pet-data-api/
RESCUEGROUPS_API_KEY=

# Include bundled demo data (Austin, TX area). Defaults to "auto":
# on when no live source is configured, off otherwise. Use "true"/"false" to force.
USE_SAMPLE_DATA=auto
